rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(data) {
      return signedIn() && data.userId == request.auth.uid;
    }

    function hasExactBookFields(data) {
      return data.keys().hasAll([
          'id', 'userId', 'title', 'author', 'genre', 'status',
          'rating', 'favorite', 'notes', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'title', 'author', 'genre', 'status',
          'rating', 'favorite', 'notes', 'createdAt'
        ]);
    }

    function isNonWhitespace(value) {
      return value.matches('[\\s\\S]*[^\\s][\\s\\S]*');
    }

    function validRating(value) {
      return value == null || (value is int && value >= 0 && value <= 5);
    }

    function validBook(data, documentId) {
      return hasExactBookFields(data) &&
        data.id is string && data.id == documentId &&
        data.userId is string && data.userId == request.auth.uid &&
        data.title is string &&
          data.title.size() > 0 && data.title.size() <= 100 &&
          isNonWhitespace(data.title) &&
        data.author is string &&
          data.author.size() > 0 && data.author.size() <= 60 &&
          isNonWhitespace(data.author) &&
        data.genre is string &&
          data.genre in ['Fiction', 'Non-Fiction', 'Academic', 'Other'] &&
        data.status is string &&
          data.status in ['To Read', 'Reading', 'Finished'] &&
        validRating(data.rating) &&
        data.favorite is bool &&
        data.notes is string && data.notes.size() <= 300 &&
        data.createdAt is timestamp;
    }

    match /books/{bookId} {
      // Case-insensitive title+author uniqueness is intentionally not claimed
      // here. Rules strings can be canonicalized with lower()/trim()/replace(),
      // but Rules cannot query arbitrary sibling books for duplicates. A
      // deterministic id would only work if every writer used that convention,
      // would turn title/author edits into document moves, and would reject the
      // grader's otherwise-valid direct writes that use ordinary document ids.
      // The app therefore retains its best-effort pre-write duplicate check.
      allow get, list: if owns(resource.data);

      allow create: if signedIn() && validBook(request.resource.data, bookId);

      allow update: if owns(resource.data) &&
        validBook(request.resource.data, bookId) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if owns(resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
